        WITH combined_invoices AS (
    -- 1. Rights Invoices (Prefix 'R')
    SELECT * FROM MEDIADMSTAGING.intermediate.int_invoice_rights
    
    UNION ALL
    
    -- 2. Technical Invoices (Prefix 'T')
