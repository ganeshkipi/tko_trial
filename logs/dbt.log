    JOIN MediaDMStaging.dbo.OrderDetail od ON oh.Id = od.OrderHeaderId
    JOIN MediaDMStaging.dbo.W_OrderRightsInvoiceOrderDetailAudit invd ON invd.OrderDetailId = od.Id
