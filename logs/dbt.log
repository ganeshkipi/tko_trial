WITH raw_sap AS (
    SELECT 
        SOL_NUMBER,
        SAP_INVOICE,
        SAP_ACCTG_DOC,
        CASE WHEN SAP_CLEAR_DOC = '' THEN NULL ELSE SAP_CLEAR_DOC END AS SAP_CLEAR_DOC,
