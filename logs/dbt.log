SELECT
    -- 1. InvoiceKey
    
    -- Generates keys like 'R1001' (Rights) or 'T1001' (Technical)
    -- Handles NULLs by defaulting to -1
    CONCAT(
        'R', 
        CAST(COALESCE(r.RecordId, -1) AS VARCHAR)
    )
 as InvoiceKey,
    -- 2. SOLItem
    COALESCE(r.RecordId, -1) AS SOLItem,
    -- 3. BillingCode
