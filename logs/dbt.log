    SELECT * FROM MEDIADMSTAGING.intermediate.int_invoice_technical
    
    UNION ALL
    
    -- 3. Default/Dummy Rows (R-1, T-1, -1)
    SELECT * FROM MEDIADMSTAGING.intermediate.int_invoice_defaults
)

