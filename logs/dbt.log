LEFT JOIN MediaDMStaging.dbo.WithholdingTaxRecord wht ON wht.Id = r.WithHoldingTaxRecordId
INNER JOIN MediaDMStaging.dbo.OrderHeader oh ON oh.Id = ri.OrderHeaderId
